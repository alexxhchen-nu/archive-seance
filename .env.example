# Copy to .env.local (untracked) and fill in. Never commit real values.
# Firebase web app config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check debug token (dev builds only). Leave empty to let the SDK generate and print one,
# then register it in Firebase console -> App Check -> Apps -> Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional
VITE_CLOUD_MODEL=
VITE_BUILD_FLAVOR=
